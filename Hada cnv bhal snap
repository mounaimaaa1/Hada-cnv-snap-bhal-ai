<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>SnapTools</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --snap-yellow: #FFFC00;
            --snap-black: #000000;
            --bg-chat: #09090b;
            --bg-workspace: #020202;
            --bg-bubble-user: #1c1c1e;
            --border-color: #27272a;
            --text-main: #fafafa;
            --text-muted: #71717a;
            --font-main: 'Plus Jakarta Sans', sans-serif;
            --chat-btn-bg: #0c0c0e;
            --chat-btn-border: #1e1e22;
            --menu-bg: rgba(9, 9, 11, 0.95);
            --alert-bg: rgba(20, 20, 25, 0.85);
            --alert-border: rgba(255, 68, 68, 0.4);
        }

        [data-theme="light"] {
            --bg-chat: #f4f4f5;
            --bg-workspace: #e4e4e7;
            --bg-bubble-user: #e4e4e7;
            --border-color: #d4d4d8;
            --text-main: #09090b;
            --text-muted: #71717a;
            --chat-btn-bg: #ffffff;
            --chat-btn-border: #e4e4e7;
            --menu-bg: rgba(244, 244, 245, 0.95);
            --alert-bg: rgba(255, 255, 255, 0.9);
            --alert-border: rgba(255, 68, 68, 0.3);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: var(--font-main); -webkit-tap-highlight-color: transparent; touch-action: manipulation; }

        body { background-color: var(--bg-workspace); color: var(--text-main); display: flex; justify-content: center; height: 100dvh; overflow: hidden; }

        .chat-container { width: 100%; max-width: 480px; background: var(--bg-chat); display: flex; flex-direction: column; height: 100dvh; position: relative; }

        .chat-header { padding: 16px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-top: calc(16px + env(safe-area-inset-top)); }

        .brand-wrapper { display: flex; align-items: center; gap: 8px; }
        .ai-brand { font-weight: 800; font-size: 22px; }
        .part-snap { color: var(--snap-yellow); }

        .chat-history { flex: 1; overflow-y: auto; padding: 10px 16px; display: flex; flex-direction: column; gap: 22px; }
        .chat-row { display: flex; gap: 14px; }
        .user-row { flex-direction: row-reverse; }
        .bot-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--snap-yellow); display: flex; align-items: center; justify-content: center; }
        .msg-bubble { font-size: 15px; line-height: 1.5; color: var(--text-main); padding-top: 6px; }
        .user-row .msg-bubble { background: var(--bg-bubble-user); padding: 12px 18px; border-radius: 18px; font-weight: 500; }

        .options-box { display: flex; flex-direction: column; gap: 12px; margin-top: 16px; width: 100%; }
        .chat-opt-btn { background: var(--chat-btn-bg); border: 1px solid var(--chat-btn-border); color: var(--text-main); padding: 18px 16px; border-radius: 18px; text-align: left; font-size: 15px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }

        .chat-input-area { padding: 12px 16px calc(24px + env(safe-area-inset-bottom)) 16px; }
        .input-box-container { background: var(--chat-btn-bg); border: 1px solid var(--border-color); border-radius: 30px; display: flex; align-items: center; padding: 6px 8px 6px 20px; }
        .gpt-input { background: transparent; border: none; outline: none; color: var(--text-main); font-size: 15px; flex-grow: 1; padding: 10px 0; }
        .send-btn { width: 40px; height: 40px; background: var(--text-main); color: var(--bg-chat); border-radius: 50%; cursor: pointer; }

        .custom-alert { position: fixed; top: 24px; left: 50%; transform: translateX(-50%) translateY(-120px); background: var(--alert-bg); backdrop-filter: blur(14px); color: #ff4444; border: 1px solid var(--alert-border); padding: 14px 22px; border-radius: 20px; font-weight: 600; z-index: 9999; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s; opacity: 0; display: flex; align-items: center; gap: 12px; }
        .custom-alert.show { transform: translateX(-50%) translateY(0); opacity: 1; }
        .hidden-row { display: none !important; }
    </style>
</head>
<body>

    <div class="custom-alert" id="errorAlert">
        <i class="fa-solid fa-circle-exclamation"></i> <span>Please enter a username first!</span>
    </div>

    <div class="chat-container">
        <div class="chat-header">
            <div class="brand-wrapper"><span class="ai-brand"><span class="part-snap">Snap</span>Tools</span></div>
        </div>

        <div class="chat-history" id="chatWindow">
            <div class="chat-row ai-row" id="welcomeMsg">
                <div class="bot-avatar"><i class="fa-solid fa-ghost"></i></div>
                <div class="msg-bubble" id="welcomeText"></div>
            </div>
        </div>

        <div class="chat-input-area">
            <div class="input-box-container">
                <input type="text" class="gpt-input" id="userInputField" placeholder="Enter target username..." autocomplete="off">
                <button class="send-btn" id="sendBtn" onclick="submitUserIdentifier()"><i class="fa-solid fa-arrow-up"></i></button>
            </div>
        </div>
    </div>

    <script>
        const chatWindow = document.getElementById('chatWindow');
        const userInputField = document.getElementById('userInputField');
        const errorAlert = document.getElementById('errorAlert');
        let currentTargetUser = "";
        let alertTimeout = null;

        function showAlertNotification() {
            if(alertTimeout) clearTimeout(alertTimeout);
            errorAlert.classList.add('show');
            alertTimeout = setTimeout(() => { errorAlert.classList.remove('show'); }, 3000);
        }

        function typeWriterEffect(elementId, text, speed = 12, callback = null) {
            let i = 0;
            const element = document.getElementById(elementId);
            function type() {
                if (i < text.length) { element.innerHTML += text.charAt(i); i++; setTimeout(type, speed); }
                else if (callback) callback();
            }
            type();
        }

        window.onload = () => { typeWriterEffect("welcomeText", "Welcome to SnapTools. Enter a target username to begin."); };

        function submitUserIdentifier() {
            const val = userInputField.value.trim();
            if (val === '') { showAlertNotification(); return; }
            currentTargetUser = val;
            userInputField.disabled = true;
            
            const row = document.createElement('div');
            row.className = 'chat-row user-row';
            row.innerHTML = `<div class="msg-bubble">${val}</div>`;
            chatWindow.appendChild(row);

            const aiRow = document.createElement('div');
            aiRow.className = 'chat-row ai-row';
            aiRow.innerHTML = `<div class="bot-avatar"><i class="fa-solid fa-ghost"></i></div><div class="msg-bubble" id="optionsContainer"></div>`;
            chatWindow.appendChild(aiRow);

            const optionsHtml = `
                <div class="options-box">
                    <button class="chat-opt-btn" onclick="checkUsernameAndSelect('Snapchat Snaping')">Snapchat Snaping</button>
                    <button class="chat-opt-btn" onclick="checkUsernameAndSelect('Private Stories')">Private Stories</button>
                </div>
            `;
            document.getElementById('optionsContainer').innerHTML = optionsHtml;
        }

        function checkUsernameAndSelect(nodeName) {
            if (!currentTargetUser) {
                showAlertNotification();
                return;
            }
            console.log("Processing: " + nodeName);
            // هنا كمل كود التحميل ديالك...
        }
    </script>
</body>
</html>
